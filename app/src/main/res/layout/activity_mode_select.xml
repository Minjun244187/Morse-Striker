<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#508E87">

    <TextView
        android:text="Select Mode"
        android:fontFamily="@font/bungee"
        android:textColor="#024039"
        android:textSize="35sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/letterModeButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="Letter Practice"
        android:fontFamily="@font/rubik"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginBottom="10dp"
        app:backgroundTint="#154D41"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/wordModeButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="Word Practice"
        android:fontFamily="@font/codystar"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginBottom="10dp"
        app:backgroundTint="#154D41"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sentenceModeButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="Sentence Practice"
        android:fontFamily="@font/nuri"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:backgroundTint="#154D41"/>

</LinearLayout>
